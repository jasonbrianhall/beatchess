# BeatChess SDL2 Makefile
# Cross-compile for Windows with: make windows
# Native Linux build with:        make linux

# ============================================================================
# COMPILER SETTINGS
# ============================================================================
CXX_LINUX = g++
CXX_WIN   = x86_64-w64-mingw32-g++

CXXFLAGS_COMMON = -Wall -Wextra -std=c++11 -DSDL_BUILD

# ============================================================================
# PACKAGE CONFIG
# ============================================================================
PKG_CONFIG_LINUX = pkg-config
PKG_CONFIG_WIN   = mingw64-pkg-config

# ============================================================================
# SDL2
# ============================================================================
SDL2_CFLAGS_LINUX := $(shell $(PKG_CONFIG_LINUX) --cflags sdl2 2>/dev/null || echo "")
SDL2_LIBS_LINUX   := $(shell $(PKG_CONFIG_LINUX) --libs   sdl2 2>/dev/null || echo "-lSDL2")

SDL2_CFLAGS_WIN   := $(shell $(PKG_CONFIG_WIN) --cflags sdl2 2>/dev/null || echo "")
SDL2_LIBS_WIN     := $(shell $(PKG_CONFIG_WIN) --libs   sdl2 2>/dev/null || echo "-lSDL2")

# ============================================================================
# SDL2_mixer
# ============================================================================
SDL2_MIXER_CFLAGS_LINUX := $(shell $(PKG_CONFIG_LINUX) --cflags SDL2_mixer 2>/dev/null || echo "")
SDL2_MIXER_LIBS_LINUX   := $(shell $(PKG_CONFIG_LINUX) --libs   SDL2_mixer 2>/dev/null || echo "-lSDL2_mixer")

SDL2_MIXER_CFLAGS_WIN   := $(shell $(PKG_CONFIG_WIN) --cflags SDL2_mixer 2>/dev/null || echo "")
SDL2_MIXER_LIBS_WIN     := $(shell $(PKG_CONFIG_WIN) --libs   SDL2_mixer 2>/dev/null || echo "-lSDL2_mixer")

# ============================================================================
# SDL2_ttf
# ============================================================================
SDL2_TTF_CFLAGS_LINUX := $(shell $(PKG_CONFIG_LINUX) --cflags SDL2_ttf 2>/dev/null || echo "")
SDL2_TTF_LIBS_LINUX   := $(shell $(PKG_CONFIG_LINUX) --libs   SDL2_ttf 2>/dev/null || echo "-lSDL2_ttf")

SDL2_TTF_CFLAGS_WIN   := $(shell $(PKG_CONFIG_WIN) --cflags SDL2_ttf 2>/dev/null || echo "")
SDL2_TTF_LIBS_WIN     := $(shell $(PKG_CONFIG_WIN) --libs   SDL2_ttf 2>/dev/null || echo "-lSDL2_ttf")

# ============================================================================
# LINUX FLAGS
# ============================================================================
CXXFLAGS_LINUX = $(CXXFLAGS_COMMON) \
                 $(SDL2_CFLAGS_LINUX) $(SDL2_MIXER_CFLAGS_LINUX) $(SDL2_TTF_CFLAGS_LINUX) \
                 -I. \
                 -DLINUX -O2 -ffunction-sections -fdata-sections -flto

LDFLAGS_LINUX  = $(SDL2_LIBS_LINUX) $(SDL2_MIXER_LIBS_LINUX) $(SDL2_TTF_LIBS_LINUX) \
                 -lm -lpthread \
                 -s -Wl,--gc-sections -flto

CXXFLAGS_LINUX_DEBUG = $(CXXFLAGS_COMMON) \
                       $(SDL2_CFLAGS_LINUX) $(SDL2_MIXER_CFLAGS_LINUX) $(SDL2_TTF_CFLAGS_LINUX) \
                       -I. \
                       -DLINUX -DDEBUG -DCHESS_AI_DEBUG -g -O0

LDFLAGS_LINUX_DEBUG  = $(SDL2_LIBS_LINUX) $(SDL2_MIXER_LIBS_LINUX) $(SDL2_TTF_LIBS_LINUX) \
                       -lm -lpthread

# ============================================================================
# WINDOWS FLAGS
# ============================================================================
CXXFLAGS_WIN = $(CXXFLAGS_COMMON) \
               $(SDL2_CFLAGS_WIN) $(SDL2_MIXER_CFLAGS_WIN) $(SDL2_TTF_CFLAGS_WIN) \
               -I. \
               -DWIN32 -D_WIN32 -D_WIN32_WINNT=0x0A00 \
               -O2 -ffunction-sections -fdata-sections -flto

LDFLAGS_WIN  = $(SDL2_LIBS_WIN) $(SDL2_MIXER_LIBS_WIN) $(SDL2_TTF_LIBS_WIN) \
               -lm -lwinmm -lws2_32 -mwindows \
               -s -Wl,--gc-sections -flto

CXXFLAGS_WIN_DEBUG = $(CXXFLAGS_COMMON) \
                     $(SDL2_CFLAGS_WIN) $(SDL2_MIXER_CFLAGS_WIN) $(SDL2_TTF_CFLAGS_WIN) \
                     -I. \
                     -DWIN32 -D_WIN32 -D_WIN32_WINNT=0x0A00 \
                     -DDEBUG -DCHESS_AI_DEBUG -g -O0

# ============================================================================
# SOURCES
# ============================================================================
SOURCES = beatchess_sdl.cpp beatchess.cpp chess_ai_move.cpp pgn.cpp chess_sound.cpp xboard.cpp

SRCS_LINUX = $(SOURCES)
SRCS_WIN   = $(SOURCES)

# ============================================================================
# OBJECTS
# ============================================================================
OBJECTS_LINUX       = $(addprefix $(BUILD_DIR_LINUX)/,       $(SRCS_LINUX:.cpp=.o))
OBJECTS_LINUX_DEBUG = $(addprefix $(BUILD_DIR_LINUX_DEBUG)/,  $(SRCS_LINUX:.cpp=.debug.o))
OBJECTS_WIN         = $(addprefix $(BUILD_DIR_WIN)/,          $(SRCS_WIN:.cpp=.win.o))
OBJECTS_WIN_DEBUG   = $(addprefix $(BUILD_DIR_WIN_DEBUG)/,    $(SRCS_WIN:.cpp=.win.debug.o))

# ============================================================================
# EXECUTABLES & BUILD DIRS
# ============================================================================
EXECUTABLE_LINUX       = beatchess_sdl
EXECUTABLE_LINUX_DEBUG = beatchess_sdl_debug
EXECUTABLE_WIN         = beatchess_sdl.exe
EXECUTABLE_WIN_DEBUG   = beatchess_sdl_debug.exe

BUILD_DIR             = build
BUILD_DIR_LINUX       = $(BUILD_DIR)/linux
BUILD_DIR_LINUX_DEBUG = $(BUILD_DIR)/linux_debug
BUILD_DIR_WIN         = $(BUILD_DIR)/windows
BUILD_DIR_WIN_DEBUG   = $(BUILD_DIR)/windows_debug

DLL_SOURCE_DIR = /usr/x86_64-w64-mingw32/sys-root/mingw/bin

$(shell mkdir -p \
    $(BUILD_DIR_LINUX) $(BUILD_DIR_LINUX_DEBUG) \
    $(BUILD_DIR_WIN)   $(BUILD_DIR_WIN_DEBUG))

# ============================================================================
# TOP-LEVEL TARGETS
# ============================================================================
.PHONY: all linux windows debug clean clean-all help check-deps

all: linux

linux: bc-linux

windows: bc-windows bc-collect-dlls

debug: bc-linux-debug bc-windows-debug

# ============================================================================
# LINUX BUILD
# ============================================================================
.PHONY: bc-linux
bc-linux: $(BUILD_DIR_LINUX)/$(EXECUTABLE_LINUX)

$(BUILD_DIR_LINUX)/$(EXECUTABLE_LINUX): $(OBJECTS_LINUX)
	@echo "Linking Linux: $@"
	$(CXX_LINUX) $(CXXFLAGS_LINUX) $^ -o $@ $(LDFLAGS_LINUX)
	@echo "✓ $@"

$(BUILD_DIR_LINUX)/%.o: %.cpp
	@echo "Compiling (Linux): $<"
	$(CXX_LINUX) $(CXXFLAGS_LINUX) -MMD -MP -c $< -o $@

# ============================================================================
# LINUX DEBUG BUILD
# ============================================================================
.PHONY: bc-linux-debug
bc-linux-debug: $(BUILD_DIR_LINUX_DEBUG)/$(EXECUTABLE_LINUX_DEBUG)

$(BUILD_DIR_LINUX_DEBUG)/$(EXECUTABLE_LINUX_DEBUG): $(OBJECTS_LINUX_DEBUG)
	@echo "Linking Linux debug: $@"
	$(CXX_LINUX) $(CXXFLAGS_LINUX_DEBUG) $^ -o $@ $(LDFLAGS_LINUX_DEBUG)
	@echo "✓ $@"

$(BUILD_DIR_LINUX_DEBUG)/%.debug.o: %.cpp
	@echo "Compiling (Linux Debug): $<"
	$(CXX_LINUX) $(CXXFLAGS_LINUX_DEBUG) -MMD -MP -c $< -o $@

# ============================================================================
# WINDOWS BUILD
# ============================================================================
.PHONY: bc-windows
bc-windows: $(BUILD_DIR_WIN)/$(EXECUTABLE_WIN)

$(BUILD_DIR_WIN)/$(EXECUTABLE_WIN): $(OBJECTS_WIN)
	@echo "Linking Windows: $@"
	$(CXX_WIN) $(CXXFLAGS_WIN) $^ -o $@ $(LDFLAGS_WIN)
	@echo "✓ $@"

$(BUILD_DIR_WIN)/%.win.o: %.cpp
	@echo "Compiling (Windows): $<"
	$(CXX_WIN) $(CXXFLAGS_WIN) -MMD -MP -c $< -o $@

# ============================================================================
# WINDOWS DEBUG BUILD
# ============================================================================
.PHONY: bc-windows-debug
bc-windows-debug: $(BUILD_DIR_WIN_DEBUG)/$(EXECUTABLE_WIN_DEBUG)

$(BUILD_DIR_WIN_DEBUG)/$(EXECUTABLE_WIN_DEBUG): $(OBJECTS_WIN_DEBUG)
	@echo "Linking Windows debug: $@"
	$(CXX_WIN) $(CXXFLAGS_WIN_DEBUG) $^ -o $@ $(LDFLAGS_WIN)
	@echo "✓ $@"

$(BUILD_DIR_WIN_DEBUG)/%.win.debug.o: %.cpp
	@echo "Compiling (Windows Debug): $<"
	$(CXX_WIN) $(CXXFLAGS_WIN_DEBUG) -MMD -MP -c $< -o $@

# ============================================================================
# DLL COLLECTION
# ============================================================================
.PHONY: bc-collect-dlls
bc-collect-dlls: $(BUILD_DIR_WIN)/$(EXECUTABLE_WIN)
	@echo "Collecting DLLs..."
	@if [ -f collect_dlls.sh ]; then \
		./collect_dlls.sh $(BUILD_DIR_WIN)/$(EXECUTABLE_WIN) $(DLL_SOURCE_DIR) $(BUILD_DIR_WIN); \
	else \
		echo "Tip: write collect_dlls.sh or copy manually:"; \
		echo "  SDL2.dll, SDL2_mixer.dll, SDL2_ttf.dll,"; \
		echo "  libwinpthread-1.dll, libgcc_s_seh-1.dll, libstdc++-6.dll"; \
	fi

# ============================================================================
# DEPENDENCY FILES
# ============================================================================
-include $(OBJECTS_LINUX:.o=.d)
-include $(OBJECTS_LINUX_DEBUG:.o=.d)
-include $(OBJECTS_WIN:.o=.d)
-include $(OBJECTS_WIN_DEBUG:.o=.d)

# ============================================================================
# UTILITY
# ============================================================================
.PHONY: check-deps
check-deps:
	@echo "=== Linux ==="
	@$(PKG_CONFIG_LINUX) --exists sdl2       && echo "✓ sdl2"       || echo "✗ sdl2"
	@$(PKG_CONFIG_LINUX) --exists SDL2_mixer  && echo "✓ SDL2_mixer" || echo "✗ SDL2_mixer"
	@$(PKG_CONFIG_LINUX) --exists SDL2_ttf    && echo "✓ SDL2_ttf"   || echo "✗ SDL2_ttf"
	@echo "=== Windows (mingw64) ==="
	@$(PKG_CONFIG_WIN) --exists sdl2       && echo "✓ sdl2"       || echo "✗ sdl2"
	@$(PKG_CONFIG_WIN) --exists SDL2_mixer  && echo "✓ SDL2_mixer" || echo "✗ SDL2_mixer"
	@$(PKG_CONFIG_WIN) --exists SDL2_ttf    && echo "✓ SDL2_ttf"   || echo "✗ SDL2_ttf"

clean:
	find $(BUILD_DIR) -type f \( -name "*.o" -o -name "*.d" \) -delete 2>/dev/null || true
	rm -f $(BUILD_DIR_LINUX)/$(EXECUTABLE_LINUX)
	rm -f $(BUILD_DIR_LINUX_DEBUG)/$(EXECUTABLE_LINUX_DEBUG)
	rm -f $(BUILD_DIR_WIN)/$(EXECUTABLE_WIN)
	rm -f $(BUILD_DIR_WIN_DEBUG)/$(EXECUTABLE_WIN_DEBUG)

clean-all:
	rm -rf $(BUILD_DIR)

help:
	@echo "BeatChess SDL2 build targets:"
	@echo "  make              - Linux build (default)"
	@echo "  make linux        - Linux build"
	@echo "  make windows      - Windows cross-compile (mingw) + collect DLLs"
	@echo "  make debug        - Debug builds for both platforms"
	@echo "  make check-deps   - Verify all dependencies are present"
	@echo "  make clean        - Remove object files and binaries"
	@echo "  make clean-all    - Remove entire build/ directory"
	@echo ""
	@echo "Windows cross-compile requires:"
	@echo "  x86_64-w64-mingw32-g++  (mingw-w64)"
	@echo "  mingw64-pkg-config"
	@echo "  mingw64 packages: sdl2, SDL2_mixer, SDL2_ttf"
	@echo "  On Fedora: sudo dnf install mingw64-SDL2 mingw64-SDL2_mixer mingw64-SDL2_ttf"
	@echo "  On Ubuntu: sudo apt install mingw-w64 mingw-w64-tools"
	@echo "             (then build SDL2 deps from source or use mxe.cc)"
